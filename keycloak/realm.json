{
  "id": "portal-dev",
  "realm": "portal-dev",
  "displayName": "Office-Self-Signing-Portal (Dev)",
  "enabled": true,
  "registrationAllowed": false,
  "groups": [
    {
      "name": "Einreicher",
      "path": "/Einreicher"
    },
    {
      "name": "Bearbeiter",
      "path": "/Bearbeiter"
    },
    {
      "name": "Admin",
      "path": "/Admin"
    }
  ],
  "clients": [
    {
      "clientId": "office-signing-portal",
      "name": "Office Signing Portal (Dev)",
      "description": "Dev-Client für das lokale Aspire-Setup",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:5000/signin-oidc"
      ],
      "webOrigins": [
        "http://localhost:5000"
      ],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        }
      ]
    }
  ]
}
