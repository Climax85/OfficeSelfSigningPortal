@page "/benachrichtigungen"
@attribute [Authorize]
@implements IDisposable
@inject NotificationService Notifications
@inject NavigationManager Navigation

<PageTitle>Benachrichtigungen</PageTitle>

<h1>Benachrichtigungen</h1>

<p>Endzustände und Rückfragen der eigenen Vorgänge (AK-08).</p>

@if (_items.Count == 0)
{
    <p>Keine Benachrichtigungen vorhanden.</p>
}
else
{
    <ul class="notifications">
        @foreach (var item in _items)
        {
            <li>
                <a href="@($"/vorgang/{item.JobId}")">
                    <span class="badge state">@item.State</span>
                    @item.OriginalFileName — @item.Message
                    <span class="timestamp">@item.OccurredAt.LocalDateTime.ToString("g")</span>
                </a>
            </li>
        }
    </ul>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private HubConnection? _hub;
    private List<NotificationItem> _items = [];

    protected override async Task OnInitializedAsync()
    {
        var userId = (await AuthenticationState).User.FindFirstValue(
            System.Security.Claims.ClaimTypes.NameIdentifier)!;
        _items = (await Notifications.GetForUserAsync(userId, CancellationToken.None)).ToList();

        _hub = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri(JobStatusHub.Route))
            .WithAutomaticReconnect()
            .Build();
        _hub.On<VorgangNotificationEvent>(
            JobStatusHub.VorgangNotificationMethod,
            pushed =>
            {
                _items.Insert(0, new NotificationItem(
                    pushed.JobId,
                    pushed.OriginalFileName,
                    pushed.State,
                    $"Vorgang erreichte den Zustand {pushed.State}.",
                    null,
                    pushed.OccurredAt));
                return InvokeAsync(StateHasChanged);
            });
        await _hub.StartAsync();
        await _hub.InvokeAsync(JobStatusHub.WatchNotificationsMethodName);
    }

    public void Dispose()
    {
        if (_hub is not null)
        {
            _ = _hub.DisposeAsync();
        }
    }
}
