@page "/benachrichtigungen"
@attribute [Authorize]
@implements IAsyncDisposable
@inject NotificationService Notifications
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<Benachrichtigungen> Logger

<PageTitle>Benachrichtigungen</PageTitle>

<h1>Benachrichtigungen</h1>

<p>Endzustände und Rückfragen der eigenen Vorgänge (AK-08).</p>

@if (_items.Count == 0)
{
    <p>Keine Benachrichtigungen vorhanden.</p>
}
else
{
    <ul class="notifications">
        @foreach (var item in _items)
        {
            <li>
                <a href="@($"/vorgang/{item.JobId}")">
                    <span class="badge state">@item.State</span>
                    @item.OriginalFileName — @item.Message
                    <span class="timestamp">@item.OccurredAt.LocalDateTime.ToString("g")</span>
                </a>
            </li>
        }
    </ul>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private BrowserHubClient? _hub;
    private List<NotificationItem> _items = [];

    protected override async Task OnInitializedAsync()
    {
        var userId = (await AuthenticationState).User.FindFirstValue(
            System.Security.Claims.ClaimTypes.NameIdentifier)!;
        _items = (await Notifications.GetForUserAsync(userId, CancellationToken.None)).ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _hub = await BrowserHubClient.StartAsync(
                JS,
                Navigation.ToAbsoluteUri(JobStatusHub.Route),
                this,
                new Dictionary<string, string>
                {
                    [JobStatusHub.VorgangNotificationMethod] = nameof(OnNotification),
                });
            await _hub.InvokeAsync(JobStatusHub.WatchNotificationsMethodName);
        }
        catch (Exception ex)
        {
            // Erwartbarer Fall vor dem Login (Negotiate → 302 auf den IdP); alles
            // andere (Netzwerk, Deserialisierung) gehört ins Log.
            Logger.LogDebug(ex, "Live-Kanal nicht verfügbar — Seite läuft ohne Push.");
            _hub = null;
        }
    }

    [Microsoft.JSInterop.JSInvokable]
    public Task OnNotification(VorgangNotificationEvent pushed)
    {
        _items.Insert(0, new NotificationItem(
            pushed.JobId,
            pushed.OriginalFileName,
            pushed.State,
            $"Vorgang erreichte den Zustand {pushed.State}.",
            null,
            pushed.OccurredAt));
        return InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null)
        {
            await _hub.DisposeAsync();
        }
    }
}
