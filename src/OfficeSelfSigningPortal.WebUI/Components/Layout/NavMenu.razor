@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<NavMenu> Logger

<nav class="nav">
    <a href="/upload">Datei einreichen</a>
    <AuthorizeView Roles="Bearbeiter">
        <a href="/dashboard">Bearbeiter-Dashboard</a>
    </AuthorizeView>
    <a href="/benachrichtigungen">Benachrichtigungen</a>
    @if (_unread > 0)
    {
        <span class="badge" title="Neue Benachrichtigungen">@_unread</span>
    }
</nav>

@code {
    private BrowserHubClient? _hub;
    private int _unread;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // In-Portal-Benachrichtigungen (AK-08): Push-Kanal für Endzustände/Rückfragen.
        // Browser-Client (BrowserHubClient): sendet den Auth-Cookie nativ — ein
        // serverseitiger Circuit-Client könnte das nicht (OIDC-Challenge am Hub).
        // Vor dem Login (Negotiate → 302 auf den IdP) bleibt der Kanal bewusst aus.
        try
        {
            _hub = await BrowserHubClient.StartAsync(
                JS,
                Navigation.ToAbsoluteUri(JobStatusHub.Route),
                this,
                new Dictionary<string, string>
                {
                    [JobStatusHub.VorgangNotificationMethod] = nameof(OnNotification),
                });
            await _hub.InvokeAsync(JobStatusHub.WatchNotificationsMethodName);
        }
        catch (Exception ex)
        {
            // Erwartbarer Fall vor dem Login (Negotiate → 302 auf den IdP); alles
            // andere (Netzwerk, Deserialisierung) gehört ins Log.
            Logger.LogDebug(ex, "Live-Kanal nicht verfügbar — Seite läuft ohne Push.");
            _hub = null;
        }
    }

    [Microsoft.JSInterop.JSInvokable]
    public Task OnNotification(VorgangNotificationEvent notification)
    {
        _unread++;
        return InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null)
        {
            await _hub.DisposeAsync();
        }
    }
}
