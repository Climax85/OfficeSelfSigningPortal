@implements IDisposable
@inject NavigationManager Navigation

<nav class="nav">
    <a href="/upload">Datei einreichen</a>
    <AuthorizeView Roles="Bearbeiter">
        <a href="/dashboard">Bearbeiter-Dashboard</a>
    </AuthorizeView>
    <a href="/benachrichtigungen">Benachrichtigungen</a>
    @if (_unread > 0)
    {
        <span class="badge" title="Neue Benachrichtigungen">@_unread</span>
    }
</nav>

@code {
    private HubConnection? _hub;
    private int _unread;

    protected override void OnInitialized()
    {
        // In-Portal-Benachrichtigungen (AK-08): Push-Kanal für Endzustände/Rückfragen.
        // Im Test-AuthHandler-Modus (Seam S1) trägt der Browser keine Fake-IdP-Header —
        // der Kanal ist dort bewusst nicht verfügbar (API-Tests decken ihn ab).
        _hub = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri(JobStatusHub.Route))
            .WithAutomaticReconnect()
            .Build();
        _hub.On<VorgangNotificationEvent>(
            JobStatusHub.VorgangNotificationMethod,
            _ =>
            {
                _unread++;
                return InvokeAsync(StateHasChanged);
            });
        _hub.StartAsync();
    }

    public void Dispose()
    {
        if (_hub is not null)
        {
            _ = _hub.DisposeAsync();
        }
    }
}
