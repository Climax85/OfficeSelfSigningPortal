{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PortalAuth": {
    "ClientId": "office-signing-portal",
    "GroupClaimType": "groups",
    "GroupRoleMap": {
      "Einreicher": "Einreicher",
      "Bearbeiter": "Bearbeiter",
      "Admin": "Admin"
    }
  },
  "Ingestion": {
    "MaxFileSizeBytes": 26214400,
    "MaxCompressionRatio": 100.0,
    "MaxDecompressedTotalBytes": 268435456,
    "UploadRateLimitPermitLimit": 10,
    "UploadRateLimitWindowSeconds": 60
  }
}
